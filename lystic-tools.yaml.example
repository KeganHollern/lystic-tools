# Copy to ~/.pi/agent/lystic-tools.yaml
# Precedence: this file > environment variable > built-in default.

webSearch:
  model: grok-4.6
  xSearch: true

webFetch:
  extraAllowedDomains: []

subagents:
  enabled: true
  maxDepth: 2
  maxParallel: 4
  outputCap: 20000
  autoWake: true

goal:
  enabled: true
  skeptics: 2          # skeptics per verification panel
  ideaGuyAfter: 3      # failed verifications between idea-guy runs
  blockedPauseAfter: 12 # blocked reports before pause; idea guy fires every 3
